keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @subject_alternative_names

[subject_alternative_names]
DNS.1  = localhost
DNS.2  = localhost.localdomain
DNS.3  = director
DNS.4  = registry

DNS.10 = cache-0
DNS.11 = cache-1

DNS.20 = origin-0
DNS.21 = origin-1
